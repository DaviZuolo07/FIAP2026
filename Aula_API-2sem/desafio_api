def sucesso(request):
        return request >= 200 and request < 300

def classificacao(endpoint, porcentagem):
    erros_seguidos = 0
    critico = 0
    for req in endpoint:
        if req >= 300:
            erros_seguidos += 1
        else:
            erros_seguidos = 0
        if erros_seguidos >= 2:
            critico += 1
    if critico >= 1:
        return "CRÍTICO"
    elif critico == 0 and porcentagem >= 80:
        return "ESTÁVEL"
    elif critico == 0 and porcentagem < 80:
        return "INSTÁVEL"



endpoints = ["/login", "/produtos", "/pedidos"]
status = [
[200, 200, 401, 200, 500],
[200, 200, 200, 200, 200],
[201, 500, 502, 201, 500],
]

for endpoint in status:
    qtd_sucesso = 0

    for req in endpoint:
        if sucesso(req):
            qtd_sucesso += 1

    porcentagem = qtd_sucesso / len(endpoint) * 100
    print(f"Endpoint: {endpoint}")
    print(f"Quantidade de sucessos: {qtd_sucesso}")
    print(f"Porcentagem: {porcentagem}")
    print(f"Classificacao: {classificacao(endpoint, porcentagem)}")
    print("")